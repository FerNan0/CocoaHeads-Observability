                "order": "desc",
                "orderBy": "1",
                "customLabel": "Event Type"
              }
            }
          ]
        },
        "uiStateJSON": "{}",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "observability-events",
